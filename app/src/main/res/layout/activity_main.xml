<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1418"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8FA3B5"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/download"
        android:visibility="gone" />

    <!-- Histórico das frases já concluídas -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E6EDF3"
            android:textIsSelectable="true"
            android:textSize="19sp" />
    </ScrollView>

    <!-- Frase sendo falada agora -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/live_box"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvZhLive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#7FA2C2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPtLive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/level"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:max="100" />

    <!-- Ajustes do microfone (recolhível) -->
    <LinearLayout
        android:id="@+id/panelSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/lbl_source"
            android:textColor="#8FA3B5"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_device"
            android:textColor="#8FA3B5"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvGain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#8FA3B5"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/sbGain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbNs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ns"
                android:textColor="#E6EDF3" />

            <CheckBox
                android:id="@+id/cbTts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tts"
                android:textColor="#E6EDF3" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="2"
            android:backgroundTint="#2E7D32"
            android:text="@string/start"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/settings" />

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/copy" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="@string/clear" />
    </LinearLayout>
</LinearLayout>
